# Copy to .env and adjust. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate a real key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-to-a-long-random-string-of-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DATABASE_URL unset to fall back to SQLite for local dev.
# Postgres example: postgres://gabriel:hunter2@localhost:5432/gabriel_homes
DATABASE_URL=

# Proxy trust — prod: True behind nginx (X-Real-IP used for rate limiting);
# dev stays False. Never read X-Forwarded-For.
TRUST_X_REAL_IP=False

# Email (console backend in dev; SMTP for prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hello@gabrielhomes.co.ke

# Media
MEDIA_ROOT=
MEDIA_URL=/media/

# Static
STATIC_ROOT=
STATIC_URL=/static/

# Site
SITE_DOMAIN=http://localhost:8000

# Production-only keys (config.settings.prod; add to .env when deploying)
# SECURE_SSL_REDIRECT=True
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
